<div class="card mb-4">
  <div class="card-header">
    <%= post.author + " schrieb am " + (new Date(post.date).toLocaleString('de-DE')) %>
  </div>
  <div class="card-body">
    <h5 class="card-title"><%= post.title %></h5>
    <p class="card-text"><%= post.text %></p>
    <p class="card-text"><%= post.text %></p>
    <% if(typeof(singleView) !== 'undefined' && singleView) { %>
        <%if(post.uploadURL != "") {%>
        <img class="card-img-bottom img-fluid" src="<%= post.img %>" >
        <%}%>
        <a href="/blog" class="btn btn-primary">zurück</a>
    <%} else { %>
        <a href="/blog/<%= post.id %>" class="btn btn-primary">Details</a>
    <%}%>
  </div>
</div>